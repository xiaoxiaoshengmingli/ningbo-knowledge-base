---
export interface Props {
  categories: Record<string, { label: string; icon: string; description: string; color: string }>;
  activeCategory?: string;
  activeTag?: string;
  allTags: { id: string; color: string }[];
}

const { categories, activeCategory, activeTag, allTags } = Astro.props;
const catKeys = Object.keys(categories);
---

<aside style="min-width:200px;">
  <div class="filter-section">
    <h4 class="filter-title">📂 分类</h4>
    <div class="filter-tags" style="flex-direction:column;gap:0.25rem;">
      <a href="." class="filter-tag" class:list={{ active: !activeCategory }} style="display:block;padding:0.375rem 0.625rem;border-radius:var(--radius-sm);font-size:var(--font-size-sm);color:var(--text-secondary);text-decoration:none;">
        全部
      </a>
      {catKeys.map(key => {
        const cat = categories[key];
        const isActive = activeCategory === key;
        return (
          <a
            href={isActive ? '.' : `?cat=${key}`}
            class="filter-tag"
            style={`
              display:block; padding:0.375rem 0.625rem; border-radius:var(--radius-sm);
              font-size:var(--font-size-sm); text-decoration:none;
              ${isActive ? `background:${cat.color}15; color:${cat.color}; font-weight:600;` : 'color:var(--text-secondary);'}
            `}
          >
            {cat.icon} {cat.label}
          </a>
        );
      })}
    </div>
  </div>

  <div class="filter-section">
    <h4 class="filter-title">🏷️ 标签</h4>
    <div class="filter-tags">
      {allTags.map(t => {
        const isActive = activeTag === t.id;
        return (
          <a
            href={isActive ? '.' : `?tag=${t.id}`}
            class="filter-tag"
            class:list={{ active: isActive }}
            style={`
              display:inline-block; padding:0.1875rem 0.5rem; border-radius:10px;
              font-size:0.6875rem; font-weight:600;
              background:${t.color}18; color:${t.color};
              text-decoration:none; transition:all 0.2s;
              ${isActive ? 'box-shadow: 0 0 0 2px ' + t.color + ';' : ''}
            `}
          >
            {t.id}
          </a>
        );
      })}
    </div>
  </div>
</aside>
