---
export interface Props {
  tagId: string;
  color?: string;
}

const { tagId, color } = Astro.props;
const base = (import.meta.env.BASE_URL || '').replace(/\/$/, '');
---

<a href={`${base}/tags/${tagId}`} class="tag-link">
  <span class="tag" style={color ? `background:${color}22;color:${color};` : ''}>
    {tagId}
  </span>
</a>

<style>
  .tag-link { text-decoration: none; }
  .tag-link:hover { text-decoration: none; }
  .tag { cursor: pointer; }
</style>
