---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import FilterSidebar from '../../components/FilterSidebar.astro';
import { getCompetitions, getCategories, getTags, getCategoryInfo } from '../../lib/content';

const base = (import.meta.env.BASE_URL || '').replace(/\/$/, '');

export async function getStaticPaths() {
  return [{ params: {}, props: {} }];
}

const competitions = getCompetitions();
const tags = getTags();
const catInfo = getCategoryInfo('competitions');
competitions.sort((a, b) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime());

const allTags = tags.filter(t => t.category === 'competition' || t.category === 'all');
---

<BaseLayout>
  <div class="breadcrumb">
    <a href={`${base}/`}>首页</a>
    <span class="separator">›</span>
    <span style="color:var(--text-secondary);">🏆 竞赛信息</span>
  </div>

  <div style="display:grid;grid-template-columns:1fr 260px;gap:1.5rem;">
    <div>
      <h1 style="font-size:1.5rem;font-weight:800;color:#fff;margin-bottom:0.5rem;">🏆 竞赛信息</h1>
      <p style="color:var(--text-secondary);font-size:var(--font-size-sm);margin-bottom:1.5rem;">
        {catInfo?.description} · 共 {competitions.length} 条
      </p>

      {competitions.length > 0 ? (
        <div style="display:flex;flex-direction:column;gap:0.75rem;">
          {competitions.map(item => (
            <ContentCard
              title={item.title}
              summary={item.summary}
              href={`${base}/competitions/${item.slug}`}
              category="🏆 竞赛信息"
              date={item.publishDate}
              tags={item.tags}
              accentColor="#00d4aa"
            />
          ))}
        </div>
      ) : (
        <div class="empty-state"><div class="icon">🏆</div><p>暂无竞赛信息数据</p></div>
      )}
    </div>
    <div>
      <FilterSidebar categories={{ competitions: catInfo! }} allTags={allTags.map(t => ({ id: t.id, color: t.color }))} />
    </div>
  </div>
</BaseLayout>
