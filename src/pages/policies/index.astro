---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentCard from '../../components/ContentCard.astro';
import FilterSidebar from '../../components/FilterSidebar.astro';
import { getPolicies, getCategories, getTags, getCategoryInfo, getContentCounts } from '../../lib/content';

export async function getStaticPaths() {
  return [{ params: {}, props: {} }];
}

const policies = getPolicies();
const tags = getTags();
const counts = getContentCounts();
const catInfo = getCategoryInfo('policies');

// Sort by publish date descending
policies.sort((a, b) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime());

const categoryMeta = { policies: catInfo! };
const allTags = tags.filter(t => t.category === 'policy' || t.category === 'all');
---

<BaseLayout>
  <div class="breadcrumb">
    <a href="/">首页</a>
    <span class="separator">›</span>
    <span style="color:var(--text-secondary);">📜 政策文件</span>
  </div>

  <div style="display:grid;grid-template-columns:1fr 260px;gap:1.5rem;">
    <div>
      <h1 style="font-size:1.5rem;font-weight:800;color:#fff;margin-bottom:0.5rem;">
        📜 政策文件
      </h1>
      <p style="color:var(--text-secondary);font-size:var(--font-size-sm);margin-bottom:1.5rem;">
        {catInfo?.description} · 共 {policies.length} 条
      </p>

      {policies.length > 0 ? (
        <div style="display:flex;flex-direction:column;gap:0.75rem;">
          {policies.map(item => (
            <ContentCard
              title={item.title}
              summary={item.summary}
              href={`/policies/${item.slug}`}
              category="📜 政策文件"
              date={item.publishDate}
              tags={item.tags}
              accentColor="#6c63ff"
            />
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <div class="icon">📂</div>
          <p>暂无政策文件数据</p>
        </div>
      )}
    </div>

    <div>
      <FilterSidebar
        categories={{ policies: catInfo! }}
        allTags={allTags.map(t => ({ id: t.id, color: t.color }))}
      />
    </div>
  </div>
</BaseLayout>
